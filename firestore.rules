rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Sai Meera — Firestore Security Rules
//
// Principle: DENY ALL by default. Only explicit allows for
// specific collections and operations.
//
// Enquiries: NO direct client writes. All inserts go through
// Cloud Functions (Admin SDK), which bypasses these rules.
// Only authenticated admins (Phase 7+) can read/update.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Enquiries ──
    // Create: DENIED to clients. Cloud Functions use Admin SDK.
    // Read/Update: Authenticated users only (admin dashboard, Phase 7+).
    // Delete: DENIED to all.
    match /enquiries/{docId} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    // ── Rate Limits (internal) ──
    // Managed exclusively by Cloud Functions via Admin SDK.
    // No client access whatsoever.
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── Default: deny everything ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
