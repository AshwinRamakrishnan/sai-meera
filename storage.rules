rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Sai Meera — Firebase Storage Security Rules
//
// ALL STORAGE IS PRIVATE.
//
// Reads:  DENIED to all clients. Admin views files via Cloud
//         Functions that generate short-lived signed URLs.
// Writes: DENIED to all clients. Uploads happen via signed
//         upload URLs generated by the authorizeUpload Cloud
//         Function (Admin SDK, server-side validated).
//
// The Admin SDK (used by Cloud Functions) bypasses these rules
// entirely — that is the intended and only write path.
// ═══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // Enquiry uploads — fully private
    match /enquiry-uploads/{enquiryId}/{fileName} {
      allow read: if false;
      allow write: if false;
    }

    // Default: deny everything
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
