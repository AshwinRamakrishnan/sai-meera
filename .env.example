# ═══════════════════════════════════════════════════════════════
# Sai Meera — Environment Variables (Supabase Migration)
#
# Copy this file to .env.local and fill in your Supabase config:
#   cp .env.example .env.local
#
# These values come from the Supabase Project Dashboard:
#   Project Settings → API
#
# IMPORTANT: .env.local is gitignored. Never commit real keys.
# ═══════════════════════════════════════════════════════════════

# Frontend Configuration (Safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════════
# Server-Side Secrets (Edge Functions ONLY)
# 
# DO NOT put these in .env.local.
# They must be securely managed via the Supabase Dashboard
# (Edge Functions -> Secrets) or the Supabase CLI:
# 
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY="your-key"
# supabase secrets set RESEND_API_KEY="your-key"
# supabase secrets set NOTIFICATION_EMAIL="print@saimeera.in"
# ═══════════════════════════════════════════════════════════════
