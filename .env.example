# ═══════════════════════════════════════════════════════════════
# Sai Meera — Environment Variables
#
# Copy this file to .env.local and fill in your Firebase config:
#   cp .env.example .env.local
#
# These values come from the Firebase Console:
#   Project Settings → General → Your apps → Web app → Config
#
# IMPORTANT: .env.local is gitignored. Never commit real keys.
#
# Note: The Firebase API key is safe to expose in client code.
# Security is enforced by Firestore rules and Cloud Functions —
# not by hiding the API key.
# ═══════════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (must match functions/index.js REGION constant)
VITE_FIREBASE_REGION=asia-south1

# ═══════════════════════════════════════════════════════════════
# Backblaze B2 Storage Configuration (Server-Side)
# 
# The following MUST be configured via Firebase Functions secrets.
# DO NOT put them in this .env.local file:
# 
# firebase functions:secrets:set B2_ENDPOINT  (e.g. https://s3.us-west-004.backblazeb2.com)
# firebase functions:secrets:set B2_REGION
# firebase functions:secrets:set B2_BUCKET
# firebase functions:secrets:set B2_APPLICATION_KEY_ID
# firebase functions:secrets:set B2_APPLICATION_KEY
# ═══════════════════════════════════════════════════════════════
